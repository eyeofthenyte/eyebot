---
# Platform credentials and connector-wide options.
discord:
  available: true
  enabled: true
  bot_token:
  mod_channel_name: mod-logs

twitch:
  available: false
  enabled: false
  tmi_token:
  client_id:
  nick:
  channels:
    - your_channel_name
  # In shared mode, each guild can override this with:
  # !platform twitch channel add <twitch_login> [<#discord_destination>]
  # A guild may add multiple channels. Each may have its own Discord go-live
  # destination; entries without one inherit twitch.destination_channel. The
  # singular channel setting remains available for compatibility.
  channel:
  # Discord destination for go-live posts. Guilds should override this with:
  # !platform twitch set destination_channel <#channel>
  destination_channel:
  live_poll_seconds: 60

youtube:
  available: false
  enabled: false
  api_key:
  client_id:
  client_secret:
  refresh_token:
  access_token:
  channel_id:
  destination_channel:
  # Search.list costs 100 quota units; 900 seconds stays near the default
  # 10,000-unit daily quota for one monitored channel.
  live_poll_seconds: 900
  videos_enabled: false
  community_posts_enabled: false
  livestream_chat_commands_enabled: false

facebook:
  available: false
  enabled: false
  app_id:
  app_secret:
  access_token:
  refresh_token:
  webhook_verify_token:
  page_id:
  destination_channel:
  live_poll_seconds: 60
  # Poll interval for ordinary posts from guild-monitored Facebook Pages.
  posts_poll_seconds: 60
  posting_enabled: false
  livestream_chat_commands_enabled: false

kick:
  available: false
  enabled: false
  client_id:
  client_secret:
  access_token:
  refresh_token:
  # Discovered from the authorized Kick account; do not guess this value.
  broadcaster_user_id:
  channel:
  destination_channel:
  live_poll_seconds: 60
  livestream_chat_commands_enabled: false

twitter:
  available: false
  enabled: false
  api_key:
  api_secret:
  bearer_token:
  access_token:
  access_token_secret:
  client_id:
  client_secret:
  refresh_token:
  user_id:
  destination_channel:
  live_poll_seconds: 60
  # X API timeline reads are billable; use a conservative polling interval.
  posts_poll_seconds: 300
  posting_enabled: false

bluesky:
  available: false
  enabled: false
  handle:
  app_password:
  destination_channel:
  posts_poll_seconds: 120
  posting_enabled: false

tiktok:
  available: false
  enabled: false
  client_key:
  client_secret:
  access_token:
  refresh_token:
  open_id:
  destination_channel:
  live_poll_seconds: 60
  videos_enabled: false
  videos_poll_seconds: 300
  posting_enabled: false

instagram:
  available: false
  enabled: false
  app_id:
  app_secret:
  access_token:
  refresh_token:
  webhook_verify_token:
  account_id:
  destination_channel:
  live_poll_seconds: 60
  # Poll interval for guild-monitored professional Instagram accounts.
  posts_poll_seconds: 60
  posting_enabled: false

substack:
  available: false
  enabled: false
  publication_url:
  email:
  credential:
  destination_channel:
  newsletters_enabled: false
  podcasts_enabled: false

kofi:
  available: false
  enabled: false
  page_url:
  verification_token:
  destination_channel:
  donations_enabled: false
  memberships_enabled: false
  shop_orders_enabled: false
  webhooks_enabled: false
