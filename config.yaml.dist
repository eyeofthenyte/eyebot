---
# Global EyeBot runtime configuration.
# Platform settings belong in platforms.yaml. Credentials belong in the
# encrypted secret store managed by src/manage_secrets.py.

# Default command prefix. Individual Discord guilds may override this value.
prefix: "!"

# Keep true for a single-owner installation. Set false only when one hosted
# EyeBot instance intentionally serves multiple Discord guilds and may join
# their independently configured Twitch channels.
private_install: true

# OAuth callbacks, webhooks, health checks, and temporary public media.
# Enable this only behind an externally reachable HTTPS reverse proxy.
gateway:
  enabled: false
  host: 0.0.0.0
  port: 8080
  public_base_url: https://bot.example.com

# Temporary HTTPS media hosting for Instagram and TikTok pull-from-URL posts.
# local_caddy is currently the only implemented provider. Caddy should proxy
# /media/* to the EyeBot gateway; files remain isolated by Discord guild ID.
public_media:
  enabled: false
  provider: local_caddy
  public_base_url: https://bot.example.com/media
  storage_path: /app/data/public_media
  retention_hours: 72
  cleanup_interval_seconds: 3600
  max_bytes_per_guild: 1073741824

  # Reserved provider names; their storage adapters are not implemented yet:
  # cloudflare_r2, amazon_s3, azure_blob, google_cloud_storage
  # Cloud credentials must eventually be stored in the encrypted secret store.

logging:
  level: DEBUG
  # terminal/stdout/syslog = terminal only; a path = file only; both = both.
  output: both
  global_directory: /app/data/logs/global
  # {name} becomes discord, gateway, twitch, kick, and so on.
  global_file: "{name}.txt"
  guild_logs_enabled: true
  guild_directory: /app/data/logs/guilds
  guild_file: "{platform}.txt"
  max_bytes: 10485760
  archive_days: 30
  archive_count: 2

google_sheets:
  # Can also be set with GOOGLE_SERVICE_ACCOUNT_FILE.
  credentials_file: /app/service_account.json
  # Tables rarely change: keep data fresh for 6 hours and usable for 7 days.
  cache_ttl: 21600
  stale_ttl: 604800
  preload: true
  refresh_in_background: true
  refresh_interval: 21600
  persistent_cache_dir: /app/data/cache/google_sheets
